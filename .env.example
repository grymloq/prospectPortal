NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Backend-only secret key. Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_replace_me
SITE_URL=https://your-portal.vercel.app
# Local sample database only. Always ignored when running on Vercel.
# TEAM_LOCAL_DEMO=true

# Web Push VAPID keys (generate once with web-push generate-vapid-keys).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# Protects /api/notifications/dispatch, called by a scheduler every minute.
CRON_SECRET=

# Privacy-safe request timings are enabled in production. Set 0 to disable.
PORTAL_TIMING_ENABLED=1
# Library rollback: set to legacy to restore reads from the compatibility store.
# Leave unset for the transactional database read model.
LIBRARY_READ_MODE=
